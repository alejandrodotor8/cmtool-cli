{
  // Compila src/ a dist/ (JavaScript) para el comando ctf-migrate.
  // Los imports `./x.ts` se reescriben a `./x.js` en la salida.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "allowJs": false,
    "checkJs": false
  },
  "include": ["src"]
}
