{
  "name": "ctf-migrate",
  "version": "0.4.0",
  "private": true,
  "description": "Migra entries de Contentful entre ambientes de forma interactiva, dejándolas en draft",
  "type": "module",
  "bin": {
    "ctf-migrate": "./bin/ctf-migrate.mjs",
    "ctf-migrate-dev": "./bin/ctf-migrate-dev.mjs"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node bin/ctf-migrate.mjs",
    "dev": "node bin/ctf-migrate-dev.mjs",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import ./test/setup.ts --test test/*.test.ts",
    "check": "tsc && biome check . && node --import ./test/setup.ts --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "contentful-management": "12.19.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
