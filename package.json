{
  "name": "cfm",
  "version": "0.16.0",
  "private": true,
  "description": "Migra entries de Contentful entre ambientes de forma interactiva, dejándolas en draft",
  "type": "module",
  "bin": {
    "cfm": "./bin/cfm.mjs",
    "cfm-dev": "./bin/cfm-dev.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:exe": "bun scripts/build-exe.mjs",
    "start": "node bin/cfm.mjs",
    "dev": "node bin/cfm-dev.mjs",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import ./test/setup.ts --test test/*.test.ts",
    "check": "tsc && biome check . && node --import ./test/setup.ts --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "contentful-management": "12.19.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "esbuild": "0.25.10",
    "typescript": "7.0.2"
  }
}
