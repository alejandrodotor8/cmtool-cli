{
  "name": "cmtool-cli",
  "version": "0.17.0",
  "description": "cfm: migra entries de Contentful entre ambientes desde la terminal, dejándolas en draft (usa cmtool-core)",
  "keywords": [
    "contentful",
    "migration",
    "environments",
    "cli"
  ],
  "license": "MIT",
  "author": "Alejandro Dotor",
  "homepage": "https://github.com/alejandrodotor8/cmtool-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejandrodotor8/cmtool-cli.git"
  },
  "bugs": {
    "url": "https://github.com/alejandrodotor8/cmtool-cli/issues"
  },
  "type": "module",
  "bin": {
    "cfm": "./bin/cfm.mjs",
    "cfm-dev": "./bin/cfm-dev.mjs"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build-release.mjs",
    "start": "node bin/cfm.mjs",
    "dev": "node bin/cfm-dev.mjs",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import ./test/setup.ts --test test/*.test.ts",
    "check": "tsc && biome check . && node --import ./test/setup.ts --test test/*.test.ts",
    "prepack": "node --run build",
    "prepublishOnly": "node --run check"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@clack/prompts": "1.8.1",
    "@types/node": "24.19.1",
    "cmtool-core": "0.17.0",
    "esbuild": "0.25.10",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
