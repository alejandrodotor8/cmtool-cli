{
  "name": "ctf-migrate",
  "version": "0.2.0",
  "private": true,
  "description": "Migra entries de Contentful entre ambientes de forma interactiva, dejándolas en draft",
  "type": "module",
  "bin": {
    "ctf-migrate": "./index.mjs"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "contentful-management": "^12.19.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
